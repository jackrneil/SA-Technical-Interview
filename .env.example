AI_MODEL=openai/gpt-5.5
# Vercel Blob (for hosting AI-generated images in outreach emails)
BLOB_READ_WRITE_TOKEN=
# Pick ONE of the two authentication modes for the AI Gateway, then put it in .env.local:
#   1. AI_GATEWAY_API_KEY=...   (generate at https://vercel.com/dashboard/ai-gateway/api-keys)
#   2. VERCEL_OIDC_TOKEN=...    (pull with `vc env pull .env.local`)
AI_GATEWAY_API_KEY=

APIFY_TOKEN=
# Defaults to 2SyF0bVxmgGr8IVCZ (the LinkedIn profile actor used in the n8n flow).
APIFY_LINKEDIN_ACTOR_ID=

RESEND_API_KEY=re_...
FROM_EMAIL=you@gmail.com
# Gmail SMTP (App Password from myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional: override recipient for testing
SMTP_FORCE_TO=

# Outreach workflow tuning (optional)
OUTREACH_CALENDLY_URL=https://calendly.com/course-pilot/30min
OUTREACH_PRODUCT_URL=
OUTREACH_PIXEL_BASE_URL=
